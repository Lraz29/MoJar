<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#FAF9F6">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/how_would_you_like_to_start"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#2D3E32"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/btnCreateHousehold"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="@string/open_a_new_shared_jar"
        android:backgroundTint="#4CAF50"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/or"
        android:layout_marginBottom="20dp"/>

    <EditText
        android:id="@+id/etInviteCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/enter_invitation_code"
        android:maxLength="6"
        android:inputType="textCapCharacters"
        android:textAlignment="center"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btnJoinHousehold"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="@string/join_an_existing_jar"
        android:backgroundTint="#81C784"/>

</LinearLayout>